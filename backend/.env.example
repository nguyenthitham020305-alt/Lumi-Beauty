# Copy file nay thanh .env roi dien gia tri that
DATABASE_URL=mysql+pymysql://root:MAT_KHAU_CUA_BAN@localhost:3307/cosmetic_shop?charset=utf8mb4

# Lay key tai https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Dia chi frontend duoc phep goi API (Vite dev server)
CORS_ORIGINS=http://localhost:5173

# Khoa ky session cookie: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# Phi van chuyen (VND): don tu FREE_SHIPPING_THRESHOLD tro len duoc mien phi
SHIPPING_FEE=30000

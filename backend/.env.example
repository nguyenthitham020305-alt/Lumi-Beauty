# ---------------------------------------------------------------------------
#  LUMI Beauty - cau hinh backend
#
#  Copy file nay thanh `.env` (cung thu muc) roi dien gia tri that:
#      copy .env.example .env          (Windows)
#      cp   .env.example .env          (macOS / Linux)
#
#  KHONG BAO GIO dua file `.env` len git - no chua khoa bi mat.
#  File `.env` da duoc .gitignore loai tru san.
# ---------------------------------------------------------------------------


# === BAT BUOC ===============================================================

# Chuoi ket noi MySQL. Sua user, mat khau, cong cho khop may ban.
# Cong mac dinh cua MySQL la 3306.
DATABASE_URL=mysql+pymysql://root:MAT_KHAU_CUA_BAN@localhost:3306/cosmetic_shop?charset=utf8mb4

# Khoa dung de ky cookie dang nhap. THIEU BIEN NAY WEB KHONG KHOI DONG DUOC.
# Sinh mot chuoi ngau nhien moi bang lenh:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=


# === CHATBOT AI =============================================================

# Lay khoa mien phi tai https://aistudio.google.com/apikey
# De trong van chay duoc: chatbot chuyen sang cau tra loi du phong,
# van goi y dung san pham co that nhung khong co loi van cua AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Thoi gian cho Gemini toi da (giay). Qua han thi dung cau tra loi du phong.
GEMINI_TIMEOUT_SECONDS=30


# === PHI VAN CHUYEN =========================================================

# Don tu FREE_SHIPPING_THRESHOLD tro len duoc mien phi van chuyen (don vi: VND)
SHIPPING_FEE=30000
FREE_SHIPPING_THRESHOLD=499000


# === TUY CHON ===============================================================

# Dia chi frontend duoc phep goi API. Nhieu dia chi thi ngan cach bang dau phay.
CORS_ORIGINS=http://localhost:5173

# Dat 1 khi chay that qua HTTPS, de cookie dang nhap chi gui qua ket noi ma hoa.
# Khi phat trien tren localhost (http) phai de 0, neu khong se khong dang nhap duoc.
SESSION_COOKIE_SECURE=0

# Nguon du lieu don vi hanh chinh, dung cho script nap tinh/phuong.
# Binh thuong khong can sua.
ADDRESS_SOURCE_URL=https://provinces.open-api.vn/api/v2/?depth=2

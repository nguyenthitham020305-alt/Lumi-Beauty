# Tai khoan nhan chuyen khoan cho ma VietQR. BANK_BIN: ma ngan hang, vd 970436 = Vietcombank
# DANG LA TAI KHOAN DEMO - thay bang tai khoan that truoc khi dung
BANK_BIN=970436
BANK_NAME=Vietcombank
